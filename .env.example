# Playwright E2E Tests - Environment Configuration

# Frontend application URL
BASE_URL=http://localhost:3000

# Backend API base URL
API_URL=http://localhost:4000/api/v1

# Test Environment
NODE_ENV=test

# Optional: API Authentication Credentials
API_USERNAME=
API_PASSWORD=

# Test User Credentials (for test data)
TEST_USER_EMAIL=dheerajyadav72005@gmail.com
TEST_USER_PASSWORD=rahul@2005
TEST_USER_FULLNAME=Test User Profile
TEST_USER_CONTACT=9876543210

# Browser Configuration
BROWSER_TIMEOUT=30000
EXPECT_TIMEOUT=15000

# Debugging
DEBUG=false
VERBOSE=false

# CI/CD Configuration
CI=false
WORKERS=3

# Network Configuration
HEADLESS=true
SLOW_MO=0

# Screenshot and Video Settings
SCREENSHOT=only-on-failure
VIDEO=retain-on-failure
TRACE=on-first-retry

# Retries
RETRIES=0
